# SyncBridge configuration — ALL OPTIONAL.
# The demo runs with ZERO config: no keys, no network, all connectors MOCK.
# Copy this to `.env` only if you are wiring up the FULL (live) version.

# --- Connectors ---------------------------------------------------------------
# Master switch. Stays `false` in the demo, forcing every connector into MOCK
# mode (no real API calls). Set to `true` only in a full build where you have
# implemented and configured the live connector code paths.
SYNCBRIDGE_LIVE_CONNECTORS=false

# Example real-connector credentials a full build would read (UNUSED in the
# demo — the mock connectors ignore them entirely). Never commit real secrets.
# SLACK_BOT_TOKEN=
# SENDGRID_API_KEY=
# CRM_API_KEY=

# --- Runtime ------------------------------------------------------------------
# Where the SQLite database lives (defaults to ./syncbridge_demo.db).
SYNCBRIDGE_DB_PATH=

# Start the background scheduler with the app (default true).
SYNCBRIDGE_ENABLE_SCHEDULER=true
